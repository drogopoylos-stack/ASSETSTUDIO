{
  "engine": "playcanvas",
  "label": "PlayCanvas",
  "dependencies": { "playcanvas": "^2.22.3" },
  "import_map": {
    "playcanvas": "./node_modules/playcanvas/build/playcanvas.mjs"
  },
  "engine_file": "node_modules/playcanvas/build/playcanvas.mjs",
  "handle": "window.__game = { app, pc }",
  "builders": [
    { "file": "src/assets.js", "export": "buildCrate", "call": "buildCrate({ app, size: 1 })",
      "note": "a wooden crate with a darker frame; size is its width in metres" },
    { "file": "src/assets.js", "export": "buildTree", "call": "buildTree({ app, height: 3 })",
      "note": "a low-poly tree, a trunk and two cones; height in metres" }
  ],
  "targets": ["crate", "tree"],
  "actions": ["jump"],
  "objects": ["camera", "sun", "ground", "crate-1", "crate-2", "tree-1", "tree-2", "player"]
}
