{
  "name": "asset-studio-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "test:steer": "esbuild tests/steer.test.tsx --bundle --format=iife --platform=browser --outfile=../data/tmp/steer.test.js --log-level=warning && node tests/steer-electron.cjs",
    "test:agentpanes": "esbuild tests/agentpanes.test.ts --bundle --format=esm --platform=node --outfile=../data/tmp/agentpanes.test.mjs --log-level=warning && node ../data/tmp/agentpanes.test.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build && npm run build:ops && npm run build:assetopen && npm run build:three && npm run build:runtime",
    "build:runtime": "esbuild src/components/engine/edit/runtime.ts --bundle --format=esm --platform=browser --minify --outfile=dist/studio-runtime.js --log-level=warning",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "electron": "electron .",
    "electron:dev": "cross-env ELECTRON_START_URL=http://localhost:5173 electron .",
    "app": "concurrently -k \"npm:dev\" \"wait-on tcp:5173 && npm:electron:dev\"",
    "test:edit": "esbuild tests/kit.test.ts --bundle --format=esm --platform=node --outfile=../data/tmp/kit.test.mjs --log-level=warning && node ../data/tmp/kit.test.mjs",
    "build:ops": "esbuild src/components/engine/edit/ops.ts --bundle --format=esm --platform=browser --outfile=dist/forge-ops.js --log-level=warning",
    "test:model": "esbuild tests/model.test.ts --bundle --format=esm --platform=node --outfile=../data/tmp/model.test.mjs --log-level=warning && node ../data/tmp/model.test.mjs",
    "test:ops": "esbuild tests/ops.test.ts --bundle --format=esm --platform=node --outfile=../data/tmp/ops.test.mjs --log-level=warning && node ../data/tmp/ops.test.mjs",
    "test": "npm run test:edit && npm run test:ops && npm run test:model && npm run test:open && npm run test:shading && npm run test:forgescript && npm run test:feedscroll && npm run test:dropfolder && npm run test:openmodel && npm run test:pollshare && npm run test:settingsswitches && npm run test:feeddetail && npm run test:verts && npm run test:terraintool && npm run test:terrain && npm run test:diffnotes && npm run test:needsyou && npm run test:presets && npm run test:handles && npm run test:nav && npm run test:models && npm run test:engines && npm run test:freemem && npm run test:livemirror && npm run test:runtime && npm run test:uiprefs && npm run test:agenttokens && npm run test:material && npm run test:opswire && npm run test:hands && npm run test:sculpt && npm run test:paint && npm run test:engineinuse && npm run test:sendprefs",
    "test:agenttokens": "esbuild tests/agenttokens.test.ts --bundle --format=esm --platform=node --outfile=../data/tmp/agenttokens.test.mjs --log-level=warning && node ../data/tmp/agenttokens.test.mjs",
    "test:uiprefs": "esbuild tests/uiprefs.test.ts --bundle --format=esm --platform=node --outfile=../data/tmp/uiprefs.test.mjs --log-level=warning && node ../data/tmp/uiprefs.test.mjs",
    "test:freemem": "esbuild tests/freemem.test.ts --bundle --format=esm --platform=node --outfile=../data/tmp/freemem.test.mjs --log-level=warning && node ../data/tmp/freemem.test.mjs",
    "build:three": "node scripts/copy-three.mjs",
    "build:assetopen": "esbuild src/components/engine/edit/assetOpen.ts --bundle --format=esm --platform=browser --outfile=dist/asset-open.js --log-level=warning",
    "test:open": "node tests/openasset.test.mjs",
    "test:shading": "esbuild tests/shading.test.ts --bundle --format=esm --platform=node --outfile=../data/tmp/shading.test.mjs --log-level=warning && node ../data/tmp/shading.test.mjs",
    "test:forgescript": "esbuild tests/forgescript.test.ts --bundle --format=esm --platform=node --outfile=../data/tmp/forgescript.test.mjs --log-level=warning && node ../data/tmp/forgescript.test.mjs",
    "test:feedscroll": "esbuild tests/feedscroll.test.ts --bundle --format=esm --platform=node --outfile=../data/tmp/feedscroll.test.mjs --log-level=warning && node ../data/tmp/feedscroll.test.mjs",
    "test:dropfolder": "esbuild tests/dropfolder.test.ts --bundle --format=esm --platform=node --outfile=../data/tmp/dropfolder.test.mjs --log-level=warning && node ../data/tmp/dropfolder.test.mjs",
    "test:openmodel": "esbuild tests/openmodel.test.ts --bundle --format=esm --platform=node --outfile=../data/tmp/openmodel.test.mjs --log-level=warning && node ../data/tmp/openmodel.test.mjs",
    "test:pollshare": "esbuild tests/pollshare.test.ts --bundle --format=esm --platform=node --outfile=../data/tmp/pollshare.test.mjs --log-level=warning && node ../data/tmp/pollshare.test.mjs",
    "test:settingsswitches": "esbuild tests/settingsswitches.test.ts --bundle --format=esm --platform=node --outfile=../data/tmp/settingsswitches.test.mjs --log-level=warning && node ../data/tmp/settingsswitches.test.mjs",
    "test:verts": "esbuild tests/verts.test.ts --bundle --format=esm --platform=node --outfile=../data/tmp/verts.test.mjs --log-level=warning && node ../data/tmp/verts.test.mjs",
    "test:terrain": "esbuild tests/terrain.test.ts --bundle --format=esm --platform=node --outfile=../data/tmp/terrain.test.mjs --log-level=warning && node ../data/tmp/terrain.test.mjs",
    "test:terraintool": "esbuild tests/terraintool.test.ts --bundle --format=esm --platform=node --outfile=../data/tmp/terraintool.test.mjs --log-level=warning && node ../data/tmp/terraintool.test.mjs",
    "test:feeddetail": "esbuild tests/feeddetail.test.ts --bundle --format=esm --platform=node --outfile=../data/tmp/feeddetail.test.mjs --log-level=warning && node ../data/tmp/feeddetail.test.mjs",
    "test:diffnotes": "esbuild tests/diffnotes.test.ts --bundle --format=esm --platform=node --outfile=../data/tmp/diffnotes.test.mjs --log-level=warning && node ../data/tmp/diffnotes.test.mjs",
    "test:needsyou": "esbuild tests/needsyou.test.ts --bundle --format=esm --platform=node --outfile=../data/tmp/needsyou.test.mjs --log-level=warning && node ../data/tmp/needsyou.test.mjs",
    "test:presets": "esbuild tests/presets.test.ts --bundle --format=esm --platform=node --outfile=../data/tmp/presets.test.mjs --log-level=warning && node ../data/tmp/presets.test.mjs",
    "test:handles": "esbuild tests/handles.test.ts --bundle --format=esm --platform=node --outfile=../data/tmp/handles.test.mjs --log-level=warning && node ../data/tmp/handles.test.mjs",
    "test:nav": "esbuild tests/nav.test.ts --bundle --format=esm --platform=node --outfile=../data/tmp/nav.test.mjs --log-level=warning && node ../data/tmp/nav.test.mjs",
    "test:models": "esbuild tests/models.test.ts --bundle --format=esm --platform=node --outfile=../data/tmp/models.test.mjs --log-level=warning && node ../data/tmp/models.test.mjs",
    "test:engines": "esbuild tests/engineparity.test.ts --bundle --format=esm --platform=node --outfile=../data/tmp/engineparity.test.mjs --log-level=warning && node ../data/tmp/engineparity.test.mjs",
    "test:livemirror": "esbuild tests/livemirror.test.ts --bundle --format=esm --platform=node --outfile=../data/tmp/livemirror.test.mjs --log-level=warning && node ../data/tmp/livemirror.test.mjs",
    "test:runtime": "esbuild tests/runtime.test.ts --bundle --format=esm --platform=node --outfile=../data/tmp/runtime.test.mjs --log-level=warning && node ../data/tmp/runtime.test.mjs",
    "test:material": "esbuild tests/material.test.ts --bundle --format=esm --platform=node --outfile=../data/tmp/material.test.mjs --log-level=warning && cross-env MATERIAL_PERF=0 node ../data/tmp/material.test.mjs",
    "test:opswire": "esbuild tests/opswire.test.ts --bundle --format=esm --platform=node --outfile=../data/tmp/opswire.test.mjs --log-level=warning && node ../data/tmp/opswire.test.mjs",
    "test:hands": "esbuild tests/hands.test.ts --bundle --format=esm --platform=node --outfile=../data/tmp/hands.test.mjs --log-level=warning && node ../data/tmp/hands.test.mjs",
    "test:sculpt": "esbuild tests/sculpt.test.ts --bundle --format=esm --platform=node --outfile=../data/tmp/sculpt.test.mjs --log-level=warning && node ../data/tmp/sculpt.test.mjs",
    "test:sendprefs": "esbuild tests/sendprefs.test.ts --bundle --format=esm --platform=node --outfile=../data/tmp/sendprefs.test.mjs --log-level=warning && node ../data/tmp/sendprefs.test.mjs",
    "test:engineinuse": "esbuild tests/engineinuse.test.ts --bundle --format=esm --platform=node --outfile=../data/tmp/engineinuse.test.mjs --log-level=warning && node ../data/tmp/engineinuse.test.mjs",
    "test:paint": "esbuild tests/paint.test.ts --bundle --format=esm --platform=node --outfile=../data/tmp/paint.test.mjs --log-level=warning && node ../data/tmp/paint.test.mjs"
  },
  "dependencies": {
    "@google/model-viewer": "^4.0.0",
    "@monaco-editor/react": "^4.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "lucide-react": "^0.469.0",
    "monaco-editor": "^0.55.1",
    "prismjs": "^1.30.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-simple-code-editor": "^0.14.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/prismjs": "^1.26.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "esbuild": "^0.25.12",
    "three": "^0.183.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.3.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "wait-on": "^8.0.1"
  }
}
