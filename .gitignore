# ── Heavy / regenerated by setup.ps1 (never commit) ──────────────────────────
backend/.venv/
.venv/
venv/
frontend/node_modules/
node_modules/
frontend/dist/
frontend/dist-electron/
frontend/.vite/

# ── ALL user data — NEVER publish ────────────────────────────────────────────
#   data/settings.json holds your API KEYS; data/checkpoints & data/rewind_backups
#   hold COPIES of your other projects' code + transcripts; data/sessions are logs.
data/
.studio-uploads/
*.log

# ── Python caches ────────────────────────────────────────────────────────────
**/__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# ── Secrets / credentials ────────────────────────────────────────────────────
.env
.env.*
*.env
**/.credentials.json
**/secrets.json
*.key

# ── OS / editor / shortcuts ──────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.lnk
*.swp
.idea/
.vscode/

# Vendored optional 3D libs (manually fetched; not needed for core — uses ComfyUI/procedural)
backend/third_party/

# graphify build artifacts (rebuildable)
graphify-out/
# stray pip/npm caches if a tool is run with the repo root as its working directory
pip/
.npm/

# ── Made on each PC by setup.ps1 / carried by the installer .exe (never commit) ──
# bin/ holds the graphify command setup puts on PATH; runtime/ is the installer's bundled
# Python, its wheels and the settings seed.
/bin/
/runtime/

# Pictures a test or a review wrote into backend/ itself (HUD shots, frame dumps). They are
# a run's output, not the app: never committed, never staged into the installer.
/backend/*.png
/backend/run-real/

# ── The installed copy's own files (Inno Setup writes the uninstaller next to the app) ──
/unins*.dat
/unins*.exe
# An old UI build kept by hand before a rebuild
frontend/dist.old/
